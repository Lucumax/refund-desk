# Template for testing against YOUR OWN PayPal sandbox. Never put real values in this file.
#
#   cp -n .env.example .env.local
#   chmod 600 .env.local
#
# Fill in .env.local (git-ignored, never committed), then load it into each new terminal:
#
#   set -a; source .env.local; set +a
#
# How to get each value: docs/GETTING_STARTED.md, "Set up your PayPal sandbox".
# Sandbox only: never use Live credentials.

# Must be exactly "sandbox".
PAYPAL_ENV=sandbox

# Developer Dashboard > Apps & Credentials > Sandbox > your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Signs the receipts. Any long random string you keep; make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_RECEIPT_HMAC_KEY=

# Optional: the merchant passcode for `python -m app --mode sandbox`.
APP_PASSCODE=

# Optional: a real model reader (see "The reader" in docs/DETAILS.md).
# APP_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# APP_MODEL_ID=
